# AI Career Agent — API Keys Template
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to git. .env.example is safe to share.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Job search: Adzuna (free official API — aggregates LinkedIn/Indeed/company sites) ---
# Register free at https://developer.adzuna.com/ and paste your app id + key.
# Without both, Adzuna search is skipped. No scraping needed.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Target countries (Adzuna codes) and results per query.
ADZUNA_COUNTRIES=it,nl
ADZUNA_ROWS_PER_QUERY=50
ADZUNA_MAX_KEYWORDS=3

# --- Phase 8 productionization (operational config) ---
MODEL_PROVIDER=anthropic
CLAUDE_MODEL=claude-opus-4-8
DATABASE_URL=data/career_agent.db
CHECKPOINT_PATH=data/langgraph_checkpoints.db
EMBEDDING_MODEL=all-MiniLM-L6-v2
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_VERSION=1.0.0
DB_JOB_LIMIT=10
# Reject JDs written in a non-English language (proxy for "this role needs that
# language"). The eligibility gate ALSO always hard-rejects JDs that explicitly
# require a non-English language (e.g. "fluent Italian required"), regardless.
NON_ENGLISH_AUTO_REJECT=true
# --- Geo focus -----------------------------------------------------------------
# Comma-separated country codes to keep (search, ingestion, prefilter, export).
# Candidate focus: Netherlands + Italy only. Empty/unset = legacy EU-wide.
# Known codes: it,nl,de,fr,es,gb,ie,ch,be,at,pt,se,dk,no,fi,pl,cz,hu,ro,bg,lt,lv,ee,cy,hr,sk,si,lu,mt,gr
GEO_COUNTRIES=it,nl

# --- API security ---
# Comma-separated API keys, each optionally bound to a tenant ("key:tenant").
# When set, requests must send a matching X-API-Key header and the tenant is
# derived from the key. Leave empty for open/dev mode (no auth). REQUIRED in prod.
#   API_KEYS=key_acme:acme,key_globex:globex
API_KEYS=
# Per-tenant requests allowed per 60s window on the /api/v2 surface.
API_RATE_LIMIT=600
# Comma-separated allowed CORS origins (empty = same-origin only).
CORS_ORIGINS=
# Set to 'multi' to enable multi-tenant SaaS mode.
TENANCY_MODE=single

# --- v6 graph convergence (opt-in write-capable stages; default OFF) ---
# When on, the graph runs `acquire_jobs` (scrape + persist) before ingestion.
ENABLE_ACQUISITION=0
# When on, the `scoring` node upserts each score into the scores table.
PERSIST_SCORES=0
# When on, the graph runs `research` (paid Claude calls) after scoring.
ENABLE_RESEARCH=0
# Only research jobs scoring at/above this threshold.
RESEARCH_MIN_SCORE=80
# Keep ONLY internship / graduate-program / trainee roles (drop mid/senior).
INTERN_ONLY=1
# When on, the graph generates resume + cover letter docs after recommendations.
# DB is content-authoritative; the .md files are write-only-if-missing projections.
ENABLE_DOCUMENTS=0
DOCUMENTS_MIN_SCORE=80
# Terminal stages (run after recommendations, in order, via the terminal runner).
# Export = projection to outputs/jobs_master.xlsx; tracker = application rows.
ENABLE_EXPORT=0
ENABLE_TRACKER=0
